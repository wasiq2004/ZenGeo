# =============================================================================
# CheckGEO.ai - environment configuration
# Copy to `.env` and fill in real values.  NEVER commit `.env`.
#
#   cp .env.example .env
#   make secrets      # prints freshly generated values for the three secrets below
# =============================================================================

# --- Core ------------------------------------------------------------------
# "development" enables permissive cookies + docs; "production" enforces
# Secure cookies, HSTS and disables the OpenAPI docs endpoints.
ENVIRONMENT=development
# Public base URL of the frontend. Used for links in emails and for CORS.
FRONTEND_URL=http://localhost:8080
# Comma-separated exact origins allowed to call the API with credentials.
# NEVER use "*" - credentialed CORS requires an explicit allow-list.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Secrets (generate unique values per environment) -----------------------
# `openssl rand -hex 32`  or  `python -c "import secrets;print(secrets.token_hex(32))"`
JWT_SECRET_KEY=change-me-generate-a-64-char-hex-string
# `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"`
# Encrypts users' BYOK LLM API keys at rest. Rotating this invalidates all
# stored keys (users must re-add them). Back it up somewhere safe.
ENCRYPTION_KEY=change-me-generate-a-fernet-key

# --- Database (Postgres container, in both stacks) ---------------------------
# Both docker-compose.yml and docker-compose.prod.yml run their own `postgres`
# service, created from the values below on first start. Nothing external to
# point at, and no manual role bootstrap: the init hook creates the
# least-privilege runtime role automatically.
#
# POSTGRES_HOST is the compose SERVICE NAME - that is how one container reaches
# another. Both stacks pin it (plus PORT and SSLMODE) in the compose file, so
# editing it here has no effect on containers; it matters only if you run the
# backend outside compose.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=geo_audit
# Production: the postgres container mints a self-signed certificate on first
# boot and refuses unencrypted TCP, so "require" (encrypt, do not verify the
# chain) is the right mode and anything weaker is rejected at startup.
# Development: the compose file overrides this to "disable" - that Postgres
# serves plain TCP and the traffic never leaves your machine.
POSTGRES_SSLMODE=require
#POSTGRES_SSLROOTCERT=/etc/ssl/certs/provider-ca.crt

# Owner role, created on first start. Used ONLY for Alembic migrations and the
# role bootstrap.
POSTGRES_USER=geo_app
POSTGRES_PASSWORD=change-me-strong-db-password

# Least-privilege runtime role, created automatically on first start by
# infra/postgres/init/10-roles.sh. The API and worker connect as this role:
# DML only, no DDL.
APP_DB_USER=geo_runtime
APP_DB_PASSWORD=change-me-strong-runtime-password

# Optional explicit DSNs. Leave BOTH commented out - the app builds them from
# the components above and appends the right TLS parameter for each driver,
# which is what both stacks want.
#
# Only set these if you need a DSN shape the components cannot express, e.g.
# pointing at a managed provider instead. Note the two spellings: asyncpg wants
# `ssl=`, libpq-based psycopg wants `sslmode=`. Docker Compose expands the
# ${...} references when it reads this file; if you run the backend outside
# Compose, write the values out literally instead.
#DATABASE_URL=postgresql+asyncpg://${APP_DB_USER}:${APP_DB_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?ssl=require
#MIGRATIONS_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=require

# --- Redis (stays local in Docker on the VPS - only Postgres moved off-box) --
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth tuning ------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Failed logins before the account is temporarily locked.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
# Require a verified email address before an audit may be started.
REQUIRE_EMAIL_VERIFICATION=true

# --- First admin (seeded by `make seed-admin`) ------------------------------
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-strong-admin-password
FIRST_ADMIN_NAME=Platform Admin

# --- Email -------------------------------------------------------------------
# Transport is chosen automatically: Resend if RESEND_API_KEY is set, else SMTP
# if SMTP_HOST is set, else the console backend (links written to the backend
# log instead of being sent - fine locally, refused in production).
#
# RESEND_API_KEY is REQUIRED in production; the app will not boot without it.
# Get one at https://resend.com/api-keys. Treat it as a secret: it can send
# mail as your domain.
RESEND_API_KEY=re_your_resend_api_key_here

# Sender, as "Display Name <address>". The DOMAIN of this address must be added
# and verified in the Resend dashboard, with SPF, DKIM and DMARC records
# published at your DNS provider - see the README, "Email delivery". Sending
# from an unverified domain is rejected outright or lands in spam.
MAIL_FROM=CheckGEO.ai <no-reply@yourdomain.example>

# SMTP fallback, used only when RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Audit engine -----------------------------------------------------------
# Storage for generated PDF reports (container path, backed by a named volume).
REPORTS_DIR=/data/reports
# Per-request timeout when fetching a user-supplied website, in seconds.
FETCH_TIMEOUT_SECONDS=15
# Max bytes read from any single fetched page (protects the worker from
# multi-GB responses).
FETCH_MAX_BYTES=3000000
# Max pages crawled for content analysis in a single audit.
MAX_PAGES_PER_AUDIT=8
# Allow the SSRF guard to resolve to private IPs. ONLY for local development
# against a site on your own machine. MUST be false in production.
ALLOW_PRIVATE_NETWORK_FETCH=false

# --- Share of Voice (pillar 7) ---------------------------------------------
# There is NO cap on how many target prompts or providers a user may test -
# the cost lands on their own API key. These are stability safeguards only:
# how many concurrent calls the worker makes to a single provider, and how long
# it waits for one completion.
SOV_PROVIDER_CONCURRENCY=3
SOV_REQUEST_TIMEOUT_SECONDS=120
SOV_MAX_RETRIES=2

# --- Rate limits (requests per window, per IP unless noted) -----------------
RATE_LIMIT_LOGIN=10/15minutes
RATE_LIMIT_SIGNUP=5/hour
RATE_LIMIT_PASSWORD_RESET=5/hour
RATE_LIMIT_AUDIT_START=20/hour
RATE_LIMIT_DEFAULT=300/minute

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# "json" for production log aggregation, "console" for readable local output.
LOG_FORMAT=console

# --- Production proxy (used by docker-compose.prod.yml / Caddy) -------------
# Domain Caddy will obtain a Let's Encrypt certificate for.
PUBLIC_DOMAIN=geo.example.com
ACME_EMAIL=admin@example.com
